# Supabase Database URLs
# Get these from your Supabase project settings -> Database -> Connection String

# Transaction pooler (Session mode) - Use this for Prisma migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Session pooler (Transaction mode) - Use this for Prisma Client queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT Secret for authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Link extraction, summaries, and search (never commit real keys)
FIRECRAWL_KEY="your-firecrawl-key"
GROQ_API_KEY="your-groq-key"
GOOGLE_API_KEY="your-google-ai-studio-key"
SUMMARY_MODEL="openai/gpt-oss-20b"
